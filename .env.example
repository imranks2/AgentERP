# AgentERP Environment Configuration
# Copy this to .env and update values

# Flask
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# Database
DATABASE_URL=postgresql://agenterp:PASSWORD@db:5432/agenterp
POSTGRES_USER=agenterp
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=agenterp

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ACCESS_TOKEN_EXPIRES=3600

# Frontend
REACT_APP_API_URL=http://localhost/api

# SaaS Admin
ADMIN_EMAIL=admin@agenterp.com
ADMIN_PASSWORD=admin123
